      "seed": 356632692,
      "version": 864,
      "versionNonce": 784951627,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786110757568,
      "link": null,
      "locked": false,
      "text": "URL shortener\n\nFR\n- create a long url from short url\n    - optionally support custom alias url\n    - optionally support expiration time\n- redirect the short url to long url\n\n\nNFR\n- highly available with eventual consistency for URL shortening\n- low latency with < 200ms on URL redirect\n- highly scalable with 100M DAU and supports 1B reads per day\n- created shorturl must be unique\n- optional - click analytics\n\n\ncore entity\n\nlong URL\nshort URL\nuser\n\n\nAPI\n\n// url shortern\nPOST /urls  -> short url\n{\nlong url\ncustom alias?\nexpiration ?\n}\n\n//url redirect\nGET /urls/{shortur}  -> redirect to short url\n\n\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "URL shortener\n\nFR\n- create a long url from short url\n    - optionally support custom alias url\n    - optionally support expiration time\n- redirect the short url to long url\n\n\nNFR\n- highly available with eventual consistency for URL shortening\n- low latency with < 200ms on URL redirect\n- highly scalable with 100M DAU and supports 1B reads per day\n- created shorturl must be unique\n- optional - click analytics\n\n\ncore entity\n\nlong URL\nshort URL\nuser\n\n\nAPI\n\n// url shortern\nPOST /urls  -> short url\n{\nlong url\ncustom alias?\nexpiration ?\n}\n\n//url redirect\nGET /urls/{shortur}  -> redirect to short url\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
